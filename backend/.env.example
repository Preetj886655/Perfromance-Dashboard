# Copy to backend/.env for local development. Do not commit real secrets.

APP_NAME=Patil Manufacturing Analytics API
APP_ENV=development

# 127.0.0.1 + 5433 = Docker Compose postgres publish default (see docker-compose.yml).
# Do not use host port 5432 if a local Windows/macOS PostgreSQL service already owns it —
# Alembic would migrate the wrong database while `docker exec` shows an empty Compose DB.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=pril_analytics
POSTGRES_USER=pril
POSTGRES_PASSWORD=pril_dev_password

# Comma-separated origins are not used; configure in Settings.cors_origins for Phase 1.

# Google Sheets: keep service-account JSON in the server environment only.
# Authentication options (choose one):
#   Option 1: Path to service-account JSON file
#     GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json
#   Option 2: Inline service-account JSON (for container/secret-manager environments)
#     GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...,"private_key":...}
#   Option 3: Alternative environment variable name
#     GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=/path/to/credentials.json
#     GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}
#     GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=/path/to/credentials.json
# The service account must have read access to the Google Sheet.
# Share the Google Sheet with the service account email (e.g., name@project.iam.gserviceaccount.com).

# Google Sheet identification
# Spreadsheet: Production Dashboard Data (new)
GOOGLE_SHEETS_SPREADSHEET_ID=1BRNzO8Qhp40x8fYBhdGNS5hb3WORA7bUjzFpg1fZL4c
# Worksheet name inside the spreadsheet (leave blank to auto-detect the first sheet)
GOOGLE_SHEETS_WORKSHEET_NAME=Sheet1
# Alternative worksheet env var (checked only if WORKSHEET_NAME is empty)
# GOOGLE_SHEETS_DEFAULT_WORKSHEET=Sheet1
# Cache TTL in seconds (default 45)
GOOGLE_SERVICE_ACCOUNT_JSON=C:/Users/Preet Jaiswal/Downloads/patil-manufacturing-dashboard-de55f867aca2.json
GOOGLE_SHEETS_CACHE_TTL_SECONDS=45