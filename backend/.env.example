# Copy to backend/.env for local development. Do not commit real secrets.

APP_NAME=Patil Manufacturing Analytics API
APP_ENV=development

# Production (Supabase Session Pooler, port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL takes precedence over the local POSTGRES_* values below.

# 127.0.0.1 + 5433 = Docker Compose postgres publish default (see docker-compose.yml).
# Do not use host port 5432 if a local Windows/macOS PostgreSQL service already owns it —
# Alembic would migrate the wrong database while `docker exec` shows an empty Compose DB.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=pril_analytics
POSTGRES_USER=pril
POSTGRES_PASSWORD=pril_dev_password

# JSON array required by pydantic-settings when set through the environment.
# Include the exact Vercel production URL and any preview URL you use.
CORS_ORIGINS=["https://your-frontend.vercel.app"]

# Comma-separated origins are not used; configure in Settings.cors_origins for Phase 1.

# Google Sheets: keep service-account JSON in the server environment only.
# Authentication options:
#   Render Production: Inline JSON string (recommended)
#     GOOGLE_SERVICE_ACCOUNT_JSON=<configured securely in environment>
#   Local Development: File path via GOOGLE_SERVICE_ACCOUNT_FILE or GOOGLE_SERVICE_ACCOUNT_JSON
#     GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
#     GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# The service account must have read access to the Google Sheet.
# Share the Google Sheet with the service account email with Viewer role.

# Google Sheet identification
# Production Spreadsheet: Medchal_Downtime & Prod (Live)
GOOGLE_SHEETS_SPREADSHEET_ID=1BRNzO8Qhp40x8fYBhdGNS5hb3WORA7bUjzFpg1fZL4c
# Worksheet name inside the spreadsheet
GOOGLE_SHEETS_WORKSHEET_NAME=Sheet1
GOOGLE_SHEETS_CACHE_TTL_SECONDS=300

# AI Chatbot configuration (GroqCloud, Hosted Hugging Face, or OpenAI)
# Recommended hosted chatbot configuration on Render:
# CHAT_PROVIDER=groq
# GROQ_API_KEY=<your-groqcloud-api-key>
# GROQ_MODEL=openai/gpt-oss-20b
# Alternative candidate: GROQ_MODEL=openai/gpt-oss-120b
# HF_TOKEN=<your-huggingface-token-read-only>
# HF_ROUTER_URL=https://router.huggingface.co/v1
# CHAT_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=<optional-fallback-openai-key>
# CHAT_FALLBACK_ENABLED=true
# CHAT_TIMEZONE=Asia/Kolkata

# Render production authentication/bootstrap configuration:
# APP_ENV=production
# AUTH_SECRET_KEY=<long-random-production-secret>
# AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# APP_BOOTSTRAP_EMAIL=<initial-admin-email>
# APP_BOOTSTRAP_EMPLOYEE_CODE=<initial-admin-code>
# APP_BOOTSTRAP_PASSWORD=<initial-admin-password>

# ERC Mk-V Line Tracker configuration
# Set this to google_sheets to use the live Google Sheet instead of the downloaded Excel snapshot.
# This does not change the login password flow or auth behavior.
LINE_TRACKER_SOURCE=google_sheets
# LINE_TRACKER_LOCAL_PATH=C:\Users\Preet Jaiswal\Downloads\ERC_MkV_Line_Tracker R0_10102026.xlsx
# LINE_TRACKER_SPREADSHEET_ID=
# LINE_TRACKER_CACHE_TTL_SECONDS=300