# Root environment defaults for Docker Compose (local development only).
# Copy to `.env` if you need to override. Never commit real production secrets.

POSTGRES_DB=pril_analytics
POSTGRES_USER=pril
POSTGRES_PASSWORD=pril_dev_password
# Host port published by Compose. Default 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_PORT=5433
